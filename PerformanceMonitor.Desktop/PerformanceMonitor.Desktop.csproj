<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AssemblyName>PerformanceMonitor.Desktop</AssemblyName>
        <RootNamespace>TaskManager</RootNamespace>
        <RollForward>LatestMajor</RollForward>
        <ApplicationIcon>..\PerformanceMonitor.Shared\Assets\app.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PerformanceMonitor.Shared\PerformanceMonitor.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\PerformanceMonitor.Shared\Assets\app.ico">
            <Link>Assets\app.ico</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
