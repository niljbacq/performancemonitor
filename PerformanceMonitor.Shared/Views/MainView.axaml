<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaskManager.ViewModels"
             xmlns:views="using:TaskManager.Views"
             x:Class="TaskManager.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#1E1E1E">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.nav[Tag=true]">
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2D2D30"/>
        </Style>

        <Style Selector="Button.nav:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3A3D"/>
        </Style>

        <Style Selector="Button.nav[Tag=true]:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#444448"/>
        </Style>

        <Style Selector="Button.nav[Tag=true]:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3A3D"/>
        </Style>

        <Style Selector="Button.homeCard">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.homeCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2D2D30"/>
        </Style>
        <Style Selector="Button.homeCard:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#333337"/>
        </Style>

        <Style Selector="Grid.mobileLayout">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </UserControl.Styles>

    <Panel>

    <Grid x:Name="DesktopLayout" Classes="desktopLayout" ColumnDefinitions="220, *">

        <Border Grid.Column="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <StackPanel Margin="10" Spacing="6">
                <Button Classes="nav" Command="{Binding SelectHomeCommand}" Content="Home" Tag="{Binding IsHomeActive}"/>
                <Button Classes="nav" Command="{Binding SelectCpuCommand}" Content="CPU" Tag="{Binding IsCpuActive}"/>
                <Button Classes="nav" Command="{Binding SelectMemoryCommand}" Content="Memory" Tag="{Binding IsMemoryActive}"/>
                <Button Classes="nav" Command="{Binding SelectDiskCommand}" Content="Disk" Tag="{Binding IsDiskActive}"/>
                <Button Classes="nav" Command="{Binding SelectWifiCommand}" Content="Wi-Fi" Tag="{Binding IsWifiActive}"/>
                <Button Classes="nav" Command="{Binding SelectGpuCommand}" Content="GPU" Tag="{Binding IsGpuActive}"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}">
            <ContentControl.DataTemplates>

                <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                    <Grid RowDefinitions="Auto, *" Margin="24">
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Image Source="/Assets/Duck.png" Width="32" Height="32" VerticalAlignment="Center"/>
                                <TextBlock Text="Performance Monitor" FontSize="28" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Choose a category to view live stats" FontSize="13" Foreground="#888888" Margin="42,2,0,0"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Columns="2" Rows="3" VerticalAlignment="Top">
                            <Button Classes="homeCard" Margin="0,0,10,10"
                                    Command="{Binding $parent[views:MainView].DataContext.SelectCpuCommand}">
                                <StackPanel>
                                    <TextBlock Text="CPU" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Utilization, speed, processes and core details" FontSize="12" Foreground="#888888" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="homeCard" Margin="10,0,0,10"
                                    Command="{Binding $parent[views:MainView].DataContext.SelectMemoryCommand}">
                                <StackPanel>
                                    <TextBlock Text="Memory" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="RAM usage, capacity and live utilization" FontSize="12" Foreground="#888888" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="homeCard" Margin="0,0,10,10"
                                    Command="{Binding $parent[views:MainView].DataContext.SelectDiskCommand}">
                                <StackPanel>
                                    <TextBlock Text="Disk" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Active time, read/write speed and capacity" FontSize="12" Foreground="#888888" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="homeCard" Margin="10,0,0,10"
                                    Command="{Binding $parent[views:MainView].DataContext.SelectWifiCommand}">
                                <StackPanel>
                                    <TextBlock Text="Wi-Fi" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Send/receive throughput and adapter details" FontSize="12" Foreground="#888888" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="homeCard" Margin="0,10,10,0"
                                    Command="{Binding $parent[views:MainView].DataContext.SelectGpuCommand}">
                                <StackPanel>
                                    <TextBlock Text="GPU" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="3D utilization, temperature and VRAM usage" FontSize="12" Foreground="#888888" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="homeCard" Margin="10,10,0,0"
                                    Command="{Binding $parent[views:MainView].DataContext.ToggleOverlayCommand}">
                                <StackPanel>
                                    <TextBlock Text="Overlay" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Floating always-on-top stats" FontSize="12" Foreground="#888888" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:MemoryViewModel}">
                    <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="24">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Memory" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Memory usage" FontSize="13" Foreground="#888888" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding TotalMemoryText}" FontSize="18" Foreground="#CCCCCC" VerticalAlignment="Top"/>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,0,0,30">
                            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                                <TextBlock Text="Live Memory Utilization" Foreground="#CCCCCC" FontSize="14"/>
                                <TextBlock Grid.Column="1" Text="{Binding MemoryUsagePercent}" Foreground="#0078D4" FontWeight="Bold" FontSize="14"/>
                            </Grid>
                            <ProgressBar Value="{Binding MemoryUsagePercentValue}" Minimum="0" Maximum="100" Height="12" Foreground="#0078D4" Background="#333333" CornerRadius="4"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,16">
                            <DockPanel IsVisible="{Binding SwapText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="Swap / ZRAM" Foreground="#888888"/>
                                <TextBlock Text="{Binding SwapText}" Foreground="White" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel IsVisible="{Binding ActiveText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="Active" Foreground="#888888"/>
                                <TextBlock Text="{Binding ActiveText}" Foreground="White" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel IsVisible="{Binding InactiveText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="Inactive" Foreground="#888888"/>
                                <TextBlock Text="{Binding InactiveText}" Foreground="White" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel IsVisible="{Binding SlabText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="Slab (kernel)" Foreground="#888888"/>
                                <TextBlock Text="{Binding SlabText}" Foreground="White" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel IsVisible="{Binding PressureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="Pressure (PSI)" Foreground="#888888"/>
                                <TextBlock Text="{Binding PressureText}" Foreground="White" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>

                        <UniformGrid Grid.Row="3" Columns="2" Rows="2" VerticalAlignment="Top">
                            <Border Background="#252526" CornerRadius="6" Padding="16" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="In use" FontSize="12" Foreground="#888888"/>
                                    <TextBlock Text="{Binding UsedMemoryText}" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#252526" CornerRadius="6" Padding="16" Margin="10,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Usage %" FontSize="12" Foreground="#888888"/>
                                    <TextBlock Text="{Binding MemoryUsagePercent}" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#252526" CornerRadius="6" Padding="16" Margin="0,10,10,0">
                                <StackPanel>
                                    <TextBlock Text="Total Hardware RAM" FontSize="12" Foreground="#888888"/>
                                    <TextBlock Text="{Binding TotalMemoryText}" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#252526" CornerRadius="6" Padding="16" Margin="10,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Status" FontSize="12" Foreground="#888888"/>
                                    <TextBlock Text="Active Monitoring" FontSize="20" FontWeight="SemiBold" Foreground="#4CAF50" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:CpuViewModel}">
                    <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="20">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,10">
                            <TextBlock Grid.Column="0" Text="CPU" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding CpuName}" FontSize="18" Foreground="#E1E1E1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="Auto, *" Margin="0,0,0,5">
                            <TextBlock Text="% Utilization" FontSize="12" Foreground="#888888"/>
                            <TextBlock Grid.Column="1" Text="100%" FontSize="12" Foreground="#888888" IsVisible="False"/>
                        </Grid>

                        <Border Grid.Row="2" Height="160" Background="#0C1013" BorderBrush="#2B3036" BorderThickness="1" CornerRadius="3" Margin="0,0,0,15" Padding="10">
                            <Grid RowDefinitions="*, Auto">
                                <ProgressBar Value="{Binding UtilizationValue}" Minimum="0" Maximum="100" Height="20" Foreground="#1289A7" Background="#1E272C" VerticalAlignment="Center" CornerRadius="2"/>
                                <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                                    <TextBlock Text="60 seconds" FontSize="11" Foreground="#666666"/>
                                    <TextBlock Grid.Column="1" Text="0" FontSize="11" Foreground="#666666"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" ColumnDefinitions="3*, 2*">
                            <StackPanel Grid.Column="0" Spacing="15" Margin="0,0,20,0">
                                <Grid ColumnDefinitions="*, *">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Utilization" FontSize="12" Foreground="#888888"/>
                                        <TextBlock Text="{Binding Utilization}" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" IsVisible="{Binding Speed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="Speed" FontSize="12" Foreground="#888888"/>
                                        <TextBlock Text="{Binding Speed}" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*, *, *">
                                    <StackPanel Grid.Column="0" IsVisible="{Binding HasProcesses}">
                                        <TextBlock Text="Processes" FontSize="12" Foreground="#888888"/>
                                        <TextBlock Text="{Binding Processes}" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" IsVisible="{Binding HasThreads}">
                                        <TextBlock Text="Threads" FontSize="12" Foreground="#888888"/>
                                        <TextBlock Text="{Binding Threads}" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" IsVisible="{Binding HasHandles}">
                                        <TextBlock Text="Handles" FontSize="12" Foreground="#888888"/>
                                        <TextBlock Text="{Binding Handles}" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel>
                                    <TextBlock Text="Up time" FontSize="12" Foreground="#888888"/>
                                    <TextBlock Text="{Binding Uptime}" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Column="1" ColumnDefinitions="Auto, *">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0">
                                    <TextBlock Text="Base speed:" Foreground="#888888"
                                               IsVisible="{Binding BaseSpeed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="Sockets:" Foreground="#888888"
                                               IsVisible="{Binding Sockets, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="Cores:" Foreground="#888888"/>
                                    <TextBlock Text="Logical processors:" Foreground="#888888"/>
                                    <TextBlock Text="Virtualization:" Foreground="#888888"
                                               IsVisible="{Binding Virtualization, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="L1 cache:" Foreground="#888888"
                                               IsVisible="{Binding L1Cache, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="L2 cache:" Foreground="#888888"
                                               IsVisible="{Binding L2Cache, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="L3 cache:" Foreground="#888888"
                                               IsVisible="{Binding L3Cache, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="Temperature:" Foreground="#888888"
                                               IsVisible="{Binding TemperatureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="Pressure (PSI):" Foreground="#888888"
                                               IsVisible="{Binding PressureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="Freq residency:" Foreground="#888888"
                                               IsVisible="{Binding FrequencyResidencyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding BaseSpeed}" Foreground="White" TextAlignment="Right" TextWrapping="Wrap"
                                               IsVisible="{Binding BaseSpeed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding Sockets}" Foreground="White" TextAlignment="Right" TextWrapping="Wrap"
                                               IsVisible="{Binding Sockets, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding Cores}" Foreground="White" TextAlignment="Right" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding LogicalProcessors}" Foreground="White" TextAlignment="Right" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Virtualization}" Foreground="White" TextAlignment="Right" TextWrapping="Wrap"
                                               IsVisible="{Binding Virtualization, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding L1Cache}" Foreground="White" TextAlignment="Right" TextWrapping="Wrap"
                                               IsVisible="{Binding L1Cache, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding L2Cache}" Foreground="White" TextAlignment="Right" TextWrapping="Wrap"
                                               IsVisible="{Binding L2Cache, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding L3Cache}" Foreground="White" TextAlignment="Right" TextWrapping="Wrap"
                                               IsVisible="{Binding L3Cache, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding TemperatureText}" Foreground="White" TextAlignment="Right" TextWrapping="Wrap"
                                               IsVisible="{Binding TemperatureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding PressureText}" Foreground="White" TextAlignment="Right" TextWrapping="Wrap"
                                               IsVisible="{Binding PressureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding FrequencyResidencyText}" Foreground="White" TextAlignment="Right" TextWrapping="Wrap"
                                               IsVisible="{Binding FrequencyResidencyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:DiskViewModel}">
                    <Grid RowDefinitions="Auto, *" Margin="20">
                        <Grid Grid.Row="0" RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, *" Margin="0,0,0,15">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Disk" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,0,15,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ModelName}" FontSize="18" Foreground="#E1E1E1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding ModelName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0"
                                        IsVisible="{Binding IoPressureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="I/O pressure (PSI): " FontSize="12" Foreground="#888888"/>
                                <TextBlock Text="{Binding IoPressureText}" FontSize="12" Foreground="#CCCCCC"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*, *" RowDefinitions="*, Auto">

                            <Border Grid.Column="0" Background="#252526" CornerRadius="6" Padding="16" Margin="0,0,8,0">
                                <ScrollViewer>
                                <StackPanel Spacing="10">
                                    <TextBlock Text="SSD" FontSize="20" FontWeight="SemiBold" Foreground="White"/>

                                    <TextBlock Text="{Binding Ssd.ModelName}" FontSize="14" Foreground="#E1E1E1" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Ssd.HasModelName}"/>
                                    <TextBlock Text="{Binding Ssd.EmptyLabel}" FontSize="14" Foreground="#888888"
                                               IsVisible="{Binding !Ssd.HasDisk}"/>

                                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4"
                                          IsVisible="{Binding Ssd.ActiveTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="Active time" FontSize="12" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="100%" FontSize="12" Foreground="#888888"/>
                                    </Grid>
                                    <Border Height="80" Background="#0C1013" BorderBrush="#2B3036" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,8"
                                            IsVisible="{Binding Ssd.ActiveTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Grid RowDefinitions="*, Auto">
                                            <ProgressBar Value="{Binding Ssd.ActiveTimeValue}" Minimum="0" Maximum="100" Height="16" Foreground="#82C91E" Background="#1E272C" VerticalAlignment="Center" CornerRadius="2"/>
                                            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                                                <TextBlock Text="60 seconds" FontSize="11" Foreground="#666666"/>
                                                <TextBlock Grid.Column="1" Text="0" FontSize="11" Foreground="#666666"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Grid ColumnDefinitions="*, *"
                                          IsVisible="{Binding Ssd.ReadSpeed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Read speed" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding Ssd.ReadSpeed}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Write speed" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding Ssd.WriteSpeed}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*, *" IsVisible="{Binding Ssd.HasDisk}">
                                        <StackPanel Grid.Column="0"
                                                    IsVisible="{Binding Ssd.AverageResponseTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="Avg response" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding Ssd.AverageResponseTime}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Capacity" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding Ssd.Capacity}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="4" IsVisible="{Binding Ssd.HasDisk}">
                                        <DockPanel><TextBlock Text="Disk" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Ssd.DiskName}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                        <DockPanel><TextBlock Text="Formatted" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Ssd.Formatted}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                        <DockPanel IsVisible="{Binding Ssd.SystemDisk, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="System disk" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Ssd.SystemDisk}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                        <DockPanel IsVisible="{Binding Ssd.PageFile, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Page file" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Ssd.PageFile}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                        <DockPanel IsVisible="{Binding Ssd.UsedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Used" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Ssd.UsedText}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                        <DockPanel IsVisible="{Binding Ssd.FreeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Free" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Ssd.FreeText}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                    </StackPanel>
                                </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Column="1" Background="#252526" CornerRadius="6" Padding="16" Margin="8,0,0,0">
                                <ScrollViewer>
                                <StackPanel Spacing="10">
                                    <TextBlock Text="HDD" FontSize="20" FontWeight="SemiBold" Foreground="White"/>

                                    <TextBlock Text="{Binding Hdd.ModelName}" FontSize="14" Foreground="#E1E1E1" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Hdd.HasModelName}"/>
                                    <TextBlock Text="{Binding Hdd.EmptyLabel}" FontSize="14" Foreground="#888888"
                                               IsVisible="{Binding !Hdd.HasDisk}"/>

                                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4"
                                          IsVisible="{Binding Hdd.ActiveTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="Active time" FontSize="12" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="100%" FontSize="12" Foreground="#888888"/>
                                    </Grid>
                                    <Border Height="80" Background="#0C1013" BorderBrush="#2B3036" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,8"
                                            IsVisible="{Binding Hdd.ActiveTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Grid RowDefinitions="*, Auto">
                                            <ProgressBar Value="{Binding Hdd.ActiveTimeValue}" Minimum="0" Maximum="100" Height="16" Foreground="#82C91E" Background="#1E272C" VerticalAlignment="Center" CornerRadius="2"/>
                                            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                                                <TextBlock Text="60 seconds" FontSize="11" Foreground="#666666"/>
                                                <TextBlock Grid.Column="1" Text="0" FontSize="11" Foreground="#666666"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Grid ColumnDefinitions="*, *"
                                          IsVisible="{Binding Hdd.ReadSpeed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Read speed" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding Hdd.ReadSpeed}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Write speed" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding Hdd.WriteSpeed}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*, *" IsVisible="{Binding Hdd.HasDisk}">
                                        <StackPanel Grid.Column="0"
                                                    IsVisible="{Binding Hdd.AverageResponseTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="Avg response" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding Hdd.AverageResponseTime}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Capacity" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding Hdd.Capacity}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="4" IsVisible="{Binding Hdd.HasDisk}">
                                        <DockPanel><TextBlock Text="Disk" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Hdd.DiskName}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                        <DockPanel><TextBlock Text="Formatted" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Hdd.Formatted}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                        <DockPanel IsVisible="{Binding Hdd.SystemDisk, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="System disk" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Hdd.SystemDisk}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                        <DockPanel IsVisible="{Binding Hdd.PageFile, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Page file" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Hdd.PageFile}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                        <DockPanel IsVisible="{Binding Hdd.UsedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Used" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Hdd.UsedText}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                        <DockPanel IsVisible="{Binding Hdd.FreeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Free" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Hdd.FreeText}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                    </StackPanel>
                                </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#252526" CornerRadius="6" Padding="16" Margin="0,10,0,0"
                                    IsVisible="{Binding Other.HasDisk}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Storage" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="{Binding Other.ModelName}" FontSize="14" Foreground="#E1E1E1" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Other.HasModelName}"/>
                                    <DockPanel><TextBlock Text="Disk" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Other.DiskName}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                    <DockPanel><TextBlock Text="Capacity" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Other.Capacity}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                    <DockPanel IsVisible="{Binding Other.UsedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Used" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Other.UsedText}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                    <DockPanel IsVisible="{Binding Other.FreeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Free" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Other.FreeText}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                </StackPanel>
                            </Border>

                        </Grid>
                    </Grid>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:WifiViewModel}">
                    <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="20">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,10">
                            <TextBlock Text="Wi-Fi" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,0,20,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding AdapterName}" FontSize="18" Foreground="#E1E1E1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,5">
                            <TextBlock Text="Throughput" FontSize="12" Foreground="#888888"/>
                            <TextBlock Grid.Column="1" Text="100 Kbps" FontSize="12" Foreground="#888888"/>
                        </Grid>

                        <Border Grid.Row="2" Height="180" Background="#0C1013" BorderBrush="#2B3036" BorderThickness="1" CornerRadius="3" Margin="0,0,0,15" Padding="10">
                            <Grid RowDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center" Spacing="8">
                                    <ProgressBar Value="{Binding SendValue}" Minimum="0" Maximum="100" Height="10" Foreground="#D63031" Background="#1E272C" CornerRadius="2"/>
                                    <ProgressBar Value="{Binding ReceiveValue}" Minimum="0" Maximum="100" Height="10" Foreground="#1289A7" Background="#1E272C" CornerRadius="2"/>
                                </StackPanel>
                                <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                                    <TextBlock Text="60 seconds" FontSize="11" Foreground="#666666"/>
                                    <TextBlock Grid.Column="1" Text="0" FontSize="11" Foreground="#666666"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" ColumnDefinitions="2*, 3*">
                            <StackPanel Grid.Column="0" Spacing="15">
                                <StackPanel>
                                    <TextBlock Text="Send" FontSize="12" Foreground="#888888"/>
                                    <TextBlock Text="{Binding SendSpeed}" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Receive" FontSize="12" Foreground="#888888"/>
                                    <TextBlock Text="{Binding ReceiveSpeed}" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Column="1" ColumnDefinitions="Auto, *" Margin="20,0,0,0">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Adapter name:" Foreground="#888888"/>
                                    <TextBlock Text="SSID:" Foreground="#888888"/>
                                    <TextBlock Text="Connection type:" Foreground="#888888"/>
                                    <TextBlock Text="IPv4 address:" Foreground="#888888"/>
                                    <TextBlock Text="IPv6 address:" Foreground="#888888"/>
                                    <TextBlock Text="Signal strength:" Foreground="#888888"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="6" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding AdapterNameLabel}" Foreground="White"/>
                                    <TextBlock Text="{Binding Ssid}" Foreground="White"/>
                                    <TextBlock Text="{Binding ConnectionType}" Foreground="White"/>
                                    <TextBlock Text="{Binding Ipv4Address}" Foreground="White"/>
                                    <TextBlock Text="{Binding Ipv6Address}" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SignalStrength}" Foreground="White"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="20,12,0,0" Spacing="4" IsVisible="{Binding WifiStandard, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <DockPanel><TextBlock Text="Standard" Foreground="#888888"/><TextBlock Text="{Binding WifiStandard}" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                <DockPanel IsVisible="{Binding SignalPercent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Signal %" Foreground="#888888"/><TextBlock Text="{Binding SignalPercent}" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                <DockPanel IsVisible="{Binding Bssid, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="BSSID" Foreground="#888888"/><TextBlock Text="{Binding Bssid}" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                <DockPanel IsVisible="{Binding Gateway, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Gateway" Foreground="#888888"/><TextBlock Text="{Binding Gateway}" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                <DockPanel IsVisible="{Binding DhcpServer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="DHCP" Foreground="#888888"/><TextBlock Text="{Binding DhcpServer}" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                <DockPanel IsVisible="{Binding Dns1, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="DNS 1" Foreground="#888888"/><TextBlock Text="{Binding Dns1}" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                <DockPanel IsVisible="{Binding Dns2, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="DNS 2" Foreground="#888888"/><TextBlock Text="{Binding Dns2}" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                <DockPanel IsVisible="{Binding Netmask, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Netmask" Foreground="#888888"/><TextBlock Text="{Binding Netmask}" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:GpuViewModel}">
                    <Grid RowDefinitions="Auto, *" Margin="20">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,15">
                            <TextBlock Grid.Column="0" Text="GPU" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding GpuName}" FontSize="18" Foreground="#E1E1E1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*, *">

                            <Border Grid.Column="0" Background="#252526" CornerRadius="6" Padding="16" Margin="0,0,8,0">
                                <ScrollViewer>
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Integrated" FontSize="20" FontWeight="SemiBold" Foreground="White"/>

                                    <TextBlock Text="{Binding Integrated.GpuName}" FontSize="14" Foreground="#E1E1E1" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Integrated.HasGpu}"/>
                                    <TextBlock Text="{Binding Integrated.EmptyLabel}" FontSize="14" Foreground="#888888"
                                               IsVisible="{Binding !Integrated.HasGpu}"/>

                                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4" IsVisible="{Binding Integrated.HasUtilizationValue}">
                                        <TextBlock Text="3D Utilization" FontSize="12" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="100%" FontSize="12" Foreground="#888888"/>
                                    </Grid>
                                    <Border Height="80" Background="#0C1013" BorderBrush="#2B3036" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,8" IsVisible="{Binding Integrated.HasUtilizationValue}">
                                        <ProgressBar Value="{Binding Integrated.UtilizationValue}" Minimum="0" Maximum="100" Height="16" Foreground="#00A8FF" Background="#1E272C" VerticalAlignment="Center" CornerRadius="2"/>
                                    </Border>

                                    <Grid ColumnDefinitions="*, *" IsVisible="{Binding Integrated.HasGpu}">
                                        <StackPanel Grid.Column="0" IsVisible="{Binding Integrated.Utilization, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="Utilization" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding Integrated.Utilization}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" IsVisible="{Binding Integrated.Temperature, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="GPU Temperature" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding Integrated.Temperature}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*, *" IsVisible="{Binding Integrated.HasGpu}">
                                        <StackPanel Grid.Column="0" IsVisible="{Binding Integrated.MemoryUsage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="GPU Memory" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding Integrated.MemoryUsage}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" IsVisible="{Binding Integrated.SharedMemoryUsage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="Shared Memory" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding Integrated.SharedMemoryUsage}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="4" IsVisible="{Binding Integrated.HasGpu}">
                                        <DockPanel IsVisible="{Binding Integrated.DriverVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Driver version" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Integrated.DriverVersion}" FontSize="12" Foreground="White" HorizontalAlignment="Right" TextWrapping="Wrap"/></DockPanel>
                                        <DockPanel IsVisible="{Binding Integrated.DriverDate, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Driver date" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Integrated.DriverDate}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                        <DockPanel IsVisible="{Binding Integrated.GraphicsApi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Graphics API" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Integrated.GraphicsApi}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                        <DockPanel IsVisible="{Binding Integrated.PhysicalLocation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Hardware location" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Integrated.PhysicalLocation}" FontSize="12" Foreground="White" HorizontalAlignment="Right" TextWrapping="Wrap"/></DockPanel>
                                        <DockPanel IsVisible="{Binding Integrated.Vendor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Vendor" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Integrated.Vendor}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                    </StackPanel>
                                </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Column="1" Background="#252526" CornerRadius="6" Padding="16" Margin="8,0,0,0">
                                <ScrollViewer>
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Dedicated" FontSize="20" FontWeight="SemiBold" Foreground="White"/>

                                    <TextBlock Text="{Binding Dedicated.GpuName}" FontSize="14" Foreground="#E1E1E1" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Dedicated.HasGpu}"/>
                                    <TextBlock Text="{Binding Dedicated.EmptyLabel}" FontSize="14" Foreground="#888888"
                                               IsVisible="{Binding !Dedicated.HasGpu}"/>

                                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4" IsVisible="{Binding Dedicated.HasUtilizationValue}">
                                        <TextBlock Text="3D Utilization" FontSize="12" Foreground="#888888"/>
                                        <TextBlock Grid.Column="1" Text="100%" FontSize="12" Foreground="#888888"/>
                                    </Grid>
                                    <Border Height="80" Background="#0C1013" BorderBrush="#2B3036" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,8" IsVisible="{Binding Dedicated.HasUtilizationValue}">
                                        <ProgressBar Value="{Binding Dedicated.UtilizationValue}" Minimum="0" Maximum="100" Height="16" Foreground="#00A8FF" Background="#1E272C" VerticalAlignment="Center" CornerRadius="2"/>
                                    </Border>

                                    <Grid ColumnDefinitions="*, *" IsVisible="{Binding Dedicated.HasGpu}">
                                        <StackPanel Grid.Column="0" IsVisible="{Binding Dedicated.Utilization, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="Utilization" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding Dedicated.Utilization}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" IsVisible="{Binding Dedicated.Temperature, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="GPU Temperature" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding Dedicated.Temperature}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*, *" IsVisible="{Binding Dedicated.HasGpu}">
                                        <StackPanel Grid.Column="0" IsVisible="{Binding Dedicated.MemoryUsage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="GPU Memory" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding Dedicated.MemoryUsage}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" IsVisible="{Binding Dedicated.SharedMemoryUsage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="Shared Memory" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding Dedicated.SharedMemoryUsage}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="4" IsVisible="{Binding Dedicated.HasGpu}">
                                        <DockPanel IsVisible="{Binding Dedicated.DriverVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Driver version" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Dedicated.DriverVersion}" FontSize="12" Foreground="White" HorizontalAlignment="Right" TextWrapping="Wrap"/></DockPanel>
                                        <DockPanel IsVisible="{Binding Dedicated.DriverDate, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Driver date" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Dedicated.DriverDate}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                        <DockPanel IsVisible="{Binding Dedicated.GraphicsApi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Graphics API" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Dedicated.GraphicsApi}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                        <DockPanel IsVisible="{Binding Dedicated.PhysicalLocation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Hardware location" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Dedicated.PhysicalLocation}" FontSize="12" Foreground="White" HorizontalAlignment="Right" TextWrapping="Wrap"/></DockPanel>
                                        <DockPanel IsVisible="{Binding Dedicated.Vendor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="Vendor" FontSize="12" Foreground="#888888"/><TextBlock Text="{Binding Dedicated.Vendor}" FontSize="12" Foreground="White" HorizontalAlignment="Right"/></DockPanel>
                                    </StackPanel>
                                </StackPanel>
                                </ScrollViewer>
                            </Border>

                        </Grid>
                    </Grid>
                </DataTemplate>

            </ContentControl.DataTemplates>
        </ContentControl>

    </Grid>

    <Grid x:Name="MobileLayout" Classes="mobileLayout" RowDefinitions="*,Auto" Background="#1E1E1E">

        <Grid.Styles>
            <Style Selector="TextBlock.mTitle">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="TextBlock.mCardTitle">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="TextBlock.mSub">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#A0A0A0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style Selector="TextBlock.mLabel">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#A0A0A0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
            </Style>
            <Style Selector="TextBlock.mValue">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style Selector="TextBlock.mBig">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style Selector="Border.mCard">
                <Setter Property="Background" Value="#252526"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14"/>
            </Style>
            <Style Selector="DockPanel.mRow">
                <Setter Property="Margin" Value="0,4"/>
            </Style>
            <Style Selector="ProgressBar">
                <Setter Property="Foreground" Value="#0078D4"/>
            </Style>
            <Style Selector="Button.mHomeCard">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Background" Value="#252526"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="MinHeight" Value="64"/>
                <Setter Property="BorderBrush" Value="#333333"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style Selector="Button.mHomeCard:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#2D2D30"/>
            </Style>
            <Style Selector="Button.mHomeCard:pressed /template/ ContentPresenter">
                <Setter Property="Background" Value="#333337"/>
            </Style>
            <Style Selector="Button.mNav">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="0,6"/>
                <Setter Property="MinHeight" Value="56"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style Selector="Button.mNav[Tag=true]">
                <Setter Property="Background" Value="#3A3A3D"/>
            </Style>
            <Style Selector="Button.mNav[Tag=true] TextBlock.mNavText">
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="Button.mNav:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#2D2D30"/>
            </Style>
            <Style Selector="Button.mNav:pressed /template/ ContentPresenter">
                <Setter Property="Background" Value="#3A3A3D"/>
            </Style>
            <Style Selector="Button.mNav[Tag=true]:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#444448"/>
            </Style>
            <Style Selector="Button.mNav[Tag=true]:pressed /template/ ContentPresenter">
                <Setter Property="Background" Value="#3A3A3D"/>
            </Style>
            <Style Selector="TextBlock.mNavIcon">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            <Style Selector="TextBlock.mNavText">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
        </Grid.Styles>

        <ContentControl Grid.Row="0" Content="{Binding CurrentView}">
            <ContentControl.DataTemplates>

                <DataTemplate DataType="{x:Type vm:HomeViewModel}" x:DataType="vm:HomeViewModel">
                    <ScrollViewer>
                        <StackPanel Margin="16" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="/Assets/Duck.png" Width="28" Height="28" VerticalAlignment="Center"/>
                                <TextBlock Classes="mTitle" Text="Performance Monitor" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Classes="mSub" Text="Tap a card for live details." Margin="36,0,0,0"/>
                            <Button Classes="mHomeCard" Command="{Binding $parent[views:MainView].DataContext.SelectCpuCommand}">
                                <StackPanel>
                                    <TextBlock Classes="mCardTitle" Text="CPU"/>
                                    <TextBlock Classes="mSub" Text="Chipset, cores, frequencies, uptime"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="mHomeCard" Command="{Binding $parent[views:MainView].DataContext.SelectMemoryCommand}">
                                <StackPanel>
                                    <TextBlock Classes="mCardTitle" Text="Memory"/>
                                    <TextBlock Classes="mSub" Text="Used and total RAM"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="mHomeCard" Command="{Binding $parent[views:MainView].DataContext.SelectDiskCommand}">
                                <StackPanel>
                                    <TextBlock Classes="mCardTitle" Text="Storage"/>
                                    <TextBlock Classes="mSub" Text="Internal storage and I/O"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="mHomeCard" Command="{Binding $parent[views:MainView].DataContext.SelectWifiCommand}">
                                <StackPanel>
                                    <TextBlock Classes="mCardTitle" Text="Wi-Fi"/>
                                    <TextBlock Classes="mSub" Text="Network, signal, speeds"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="mHomeCard" Command="{Binding $parent[views:MainView].DataContext.SelectGpuCommand}">
                                <StackPanel>
                                    <TextBlock Classes="mCardTitle" Text="GPU"/>
                                    <TextBlock Classes="mSub" Text="Graphics device details"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="mHomeCard" Command="{Binding $parent[views:MainView].DataContext.ToggleOverlayCommand}">
                                <StackPanel>
                                    <TextBlock Classes="mCardTitle" Text="Overlay"/>
                                    <TextBlock Classes="mSub" Text="Floating stats over other apps"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:CpuViewModel}" x:DataType="vm:CpuViewModel">
                    <ScrollViewer>
                        <StackPanel Margin="16" Spacing="12">
                            <TextBlock Classes="mTitle" Text="CPU"/>
                            <TextBlock Classes="mSub" Text="{Binding CpuName}"/>

                            <!-- Utilization card: only when the OS actually reports CPU% -->
                            <Border Classes="mCard" IsVisible="{Binding HasUtilization}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="mLabel" Margin="0" Text="Utilization"/>
                                    <TextBlock Classes="mBig" Text="{Binding Utilization}"/>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding UtilizationValue}"/>
                                    <TextBlock Classes="mSub" Text="{Binding HardwareName}"
                                               IsVisible="{Binding HardwareName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Chipset card: shown when utilization is blocked (Android) -->
                            <Border Classes="mCard" IsVisible="{Binding !HasUtilization}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="mLabel" Margin="0" Text="Chipset"/>
                                    <TextBlock Classes="mBig" Text="{Binding CpuName}"/>
                                    <TextBlock Classes="mSub" Text="{Binding UsageNote}"
                                               IsVisible="{Binding UsageNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Classes="mSub" Text="{Binding ClusterText}"
                                               IsVisible="{Binding ClusterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="mCard">
                                <StackPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding Speed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Speed"/><TextBlock Classes="mValue" Text="{Binding Speed}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding BaseSpeed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Base speed"/><TextBlock Classes="mValue" Text="{Binding BaseSpeed}"/></DockPanel>
                                    <DockPanel Classes="mRow"><TextBlock Classes="mLabel" Text="Cores"/><TextBlock Classes="mValue" Text="{Binding Cores}"/></DockPanel>
                                    <DockPanel Classes="mRow"><TextBlock Classes="mLabel" Text="Logical processors"/><TextBlock Classes="mValue" Text="{Binding LogicalProcessors}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding Sockets, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Sockets"/><TextBlock Classes="mValue" Text="{Binding Sockets}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding Virtualization, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Virtualization"/><TextBlock Classes="mValue" Text="{Binding Virtualization}"/></DockPanel>
                                    <DockPanel Classes="mRow"><TextBlock Classes="mLabel" Text="Uptime"/><TextBlock Classes="mValue" Text="{Binding Uptime}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding TemperatureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Temperature"/><TextBlock Classes="mValue" Text="{Binding TemperatureText}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding PressureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Pressure (PSI)"/><TextBlock Classes="mValue" Text="{Binding PressureText}"/></DockPanel>
                                    <TextBlock Classes="mLabel" Margin="0,8,0,0" Text="Android details"
                                               IsVisible="{Binding ClusterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <DockPanel Classes="mRow" IsVisible="{Binding FrequencyMinText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Min frequency"/><TextBlock Classes="mValue" Text="{Binding FrequencyMinText}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding FrequencyMaxText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Max frequency"/><TextBlock Classes="mValue" Text="{Binding FrequencyMaxText}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding CpuGovernor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Governor"/><TextBlock Classes="mValue" Text="{Binding CpuGovernor}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding SupportedAbis, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Supported ABIs"/><TextBlock Classes="mValue" Text="{Binding SupportedAbis}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding ClusterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Clusters"/><TextBlock Classes="mValue" Text="{Binding ClusterText}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding PerCoreFrequencyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Per-core now"/><TextBlock Classes="mValue" Text="{Binding PerCoreFrequencyText}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding FrequencyResidencyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Frequency residency"/><TextBlock Classes="mValue" Text="{Binding FrequencyResidencyText}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding AppUsageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="This app CPU"/><TextBlock Classes="mValue" Text="{Binding AppUsageText}"/></DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Classes="mCard">
                                <StackPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding Processes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Processes"/><TextBlock Classes="mValue" Text="{Binding Processes}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding Threads, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Threads"/><TextBlock Classes="mValue" Text="{Binding Threads}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding Handles, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Handles"/><TextBlock Classes="mValue" Text="{Binding Handles}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding L1Cache, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="L1 cache"/><TextBlock Classes="mValue" Text="{Binding L1Cache}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding L2Cache, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="L2 cache"/><TextBlock Classes="mValue" Text="{Binding L2Cache}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding L3Cache, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="L3 cache"/><TextBlock Classes="mValue" Text="{Binding L3Cache}"/></DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:MemoryViewModel}" x:DataType="vm:MemoryViewModel">
                    <ScrollViewer>
                        <StackPanel Margin="16" Spacing="12">
                            <TextBlock Classes="mTitle" Text="Memory"/>
                            <Border Classes="mCard">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="mLabel" Margin="0" Text="In use"/>
                                    <TextBlock Classes="mBig" Text="{Binding MemoryUsagePercent}"/>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding MemoryUsagePercentValue}"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="mCard">
                                <StackPanel>
                                    <DockPanel Classes="mRow"><TextBlock Classes="mLabel" Text="Used"/><TextBlock Classes="mValue" Text="{Binding UsedMemoryText}"/></DockPanel>
                                    <DockPanel Classes="mRow"><TextBlock Classes="mLabel" Text="Total"/><TextBlock Classes="mValue" Text="{Binding TotalMemoryText}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding SwapText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Swap / ZRAM"/><TextBlock Classes="mValue" Text="{Binding SwapText}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding ActiveText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Active"/><TextBlock Classes="mValue" Text="{Binding ActiveText}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding InactiveText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Inactive"/><TextBlock Classes="mValue" Text="{Binding InactiveText}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding SlabText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Slab (kernel)"/><TextBlock Classes="mValue" Text="{Binding SlabText}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding PressureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Pressure (PSI)"/><TextBlock Classes="mValue" Text="{Binding PressureText}"/></DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:DiskViewModel}" x:DataType="vm:DiskViewModel">
                    <ScrollViewer>
                        <StackPanel Margin="16" Spacing="12">
                            <TextBlock Classes="mTitle" Text="Storage"/>

                            <Border Classes="mCard" IsVisible="{Binding IoPressureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <DockPanel>
                                    <TextBlock Classes="mLabel" Text="I/O pressure (PSI)"/>
                                    <TextBlock Classes="mValue" Text="{Binding IoPressureText}"/>
                                </DockPanel>
                            </Border>

                            <!-- Internal storage card: neutral type until the OS tells us SSD/HDD -->
                            <Border Classes="mCard">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="mCardTitle" Text="Internal Storage"/>
                                    <TextBlock Classes="mSub" Text="{Binding Other.ModelName}" IsVisible="{Binding Other.HasModelName}"/>
                                    <TextBlock Classes="mSub" Text="{Binding Other.EmptyLabel}" IsVisible="{Binding !Other.HasDisk}"/>

                                    <StackPanel Spacing="8" IsVisible="{Binding Other.HasDisk}">
                                        <!-- Read speed bar (10 MB/s = 10485760 bytes/s max) -->
                                        <StackPanel Spacing="4"
                                                    IsVisible="{Binding Other.ReadSpeed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <DockPanel>
                                                <TextBlock Classes="mLabel" Margin="0" Text="Read speed"/>
                                                <TextBlock Classes="mValue" Text="{Binding Other.ReadSpeed}"/>
                                            </DockPanel>
                                            <ProgressBar Minimum="0" Maximum="10485760" Value="{Binding Other.ReadSpeedBytes}" Height="6"/>
                                        </StackPanel>

                                        <!-- Write speed bar -->
                                        <StackPanel Spacing="4"
                                                    IsVisible="{Binding Other.WriteSpeed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <DockPanel>
                                                <TextBlock Classes="mLabel" Margin="0" Text="Write speed"/>
                                                <TextBlock Classes="mValue" Text="{Binding Other.WriteSpeed}"/>
                                            </DockPanel>
                                            <ProgressBar Minimum="0" Maximum="10485760" Value="{Binding Other.WriteSpeedBytes}" Height="6"/>
                                        </StackPanel>

                                        <DockPanel Classes="mRow" IsVisible="{Binding Other.AverageResponseTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Avg. response"/><TextBlock Classes="mValue" Text="{Binding Other.AverageResponseTime}"/></DockPanel>
                                        <DockPanel Classes="mRow"><TextBlock Classes="mLabel" Text="Disk"/><TextBlock Classes="mValue" Text="{Binding Other.DiskName}"/></DockPanel>
                                        <DockPanel Classes="mRow"><TextBlock Classes="mLabel" Text="Capacity"/><TextBlock Classes="mValue" Text="{Binding Other.Capacity}"/></DockPanel>
                                        <DockPanel Classes="mRow"><TextBlock Classes="mLabel" Text="Formatted"/><TextBlock Classes="mValue" Text="{Binding Other.Formatted}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Other.SystemDisk, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="System disk"/><TextBlock Classes="mValue" Text="{Binding Other.SystemDisk}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Other.PageFile, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Page file"/><TextBlock Classes="mValue" Text="{Binding Other.PageFile}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Other.UsedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Used"/><TextBlock Classes="mValue" Text="{Binding Other.UsedText}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Other.FreeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Free"/><TextBlock Classes="mValue" Text="{Binding Other.FreeText}"/></DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- HDD card: only shown if a real HDD is present (never on Android) -->
                            <Border Classes="mCard" IsVisible="{Binding Hdd.HasDisk}">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="mCardTitle" Text="HDD"/>
                                    <TextBlock Classes="mSub" Text="{Binding Hdd.ModelName}" IsVisible="{Binding Hdd.HasModelName}"/>

                                    <StackPanel Spacing="8">
                                        <StackPanel Spacing="4"
                                                    IsVisible="{Binding Hdd.ReadSpeed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <DockPanel>
                                                <TextBlock Classes="mLabel" Margin="0" Text="Read speed"/>
                                                <TextBlock Classes="mValue" Text="{Binding Hdd.ReadSpeed}"/>
                                            </DockPanel>
                                            <ProgressBar Minimum="0" Maximum="10485760" Value="{Binding Hdd.ReadSpeedBytes}" Height="6"/>
                                        </StackPanel>

                                        <StackPanel Spacing="4"
                                                    IsVisible="{Binding Hdd.WriteSpeed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <DockPanel>
                                                <TextBlock Classes="mLabel" Margin="0" Text="Write speed"/>
                                                <TextBlock Classes="mValue" Text="{Binding Hdd.WriteSpeed}"/>
                                            </DockPanel>
                                            <ProgressBar Minimum="0" Maximum="10485760" Value="{Binding Hdd.WriteSpeedBytes}" Height="6"/>
                                        </StackPanel>

                                        <DockPanel Classes="mRow" IsVisible="{Binding Hdd.AverageResponseTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Avg. response"/><TextBlock Classes="mValue" Text="{Binding Hdd.AverageResponseTime}"/></DockPanel>
                                        <DockPanel Classes="mRow"><TextBlock Classes="mLabel" Text="Disk"/><TextBlock Classes="mValue" Text="{Binding Hdd.DiskName}"/></DockPanel>
                                        <DockPanel Classes="mRow"><TextBlock Classes="mLabel" Text="Capacity"/><TextBlock Classes="mValue" Text="{Binding Hdd.Capacity}"/></DockPanel>
                                        <DockPanel Classes="mRow"><TextBlock Classes="mLabel" Text="Formatted"/><TextBlock Classes="mValue" Text="{Binding Hdd.Formatted}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Hdd.SystemDisk, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="System disk"/><TextBlock Classes="mValue" Text="{Binding Hdd.SystemDisk}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Hdd.PageFile, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Page file"/><TextBlock Classes="mValue" Text="{Binding Hdd.PageFile}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Hdd.UsedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Used"/><TextBlock Classes="mValue" Text="{Binding Hdd.UsedText}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Hdd.FreeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Free"/><TextBlock Classes="mValue" Text="{Binding Hdd.FreeText}"/></DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:WifiViewModel}" x:DataType="vm:WifiViewModel">
                    <ScrollViewer>
                        <StackPanel Margin="16" Spacing="12">
                            <TextBlock Classes="mTitle" Text="Wi-Fi"/>
                            <TextBlock Classes="mSub" Text="{Binding Ssid}"/>

                            <!-- Send / Receive bars (100 Mbps = 100000 Kbps max) -->
                            <Border Classes="mCard">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="4">
                                        <DockPanel>
                                            <TextBlock Classes="mLabel" Margin="0" Text="Send"/>
                                            <TextBlock Classes="mValue" Text="{Binding SendSpeed}"/>
                                        </DockPanel>
                                        <ProgressBar Minimum="0" Maximum="100000" Value="{Binding SendValue}" Height="6"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <DockPanel>
                                            <TextBlock Classes="mLabel" Margin="0" Text="Receive"/>
                                            <TextBlock Classes="mValue" Text="{Binding ReceiveSpeed}"/>
                                        </DockPanel>
                                        <ProgressBar Minimum="0" Maximum="100000" Value="{Binding ReceiveValue}" Height="6"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="mCard">
                                <StackPanel>
                                    <DockPanel Classes="mRow"><TextBlock Classes="mLabel" Text="Status"/><TextBlock Classes="mValue" Text="{Binding Status}"/></DockPanel>
                                    <DockPanel Classes="mRow"><TextBlock Classes="mLabel" Text="Signal"/><TextBlock Classes="mValue" Text="{Binding SignalStrength}"/></DockPanel>
                                    <DockPanel Classes="mRow"><TextBlock Classes="mLabel" Text="Connection"/><TextBlock Classes="mValue" Text="{Binding ConnectionType}"/></DockPanel>
                                    <DockPanel Classes="mRow"><TextBlock Classes="mLabel" Text="IPv4"/><TextBlock Classes="mValue" Text="{Binding Ipv4Address}"/></DockPanel>
                                    <DockPanel Classes="mRow"><TextBlock Classes="mLabel" Text="IPv6"/><TextBlock Classes="mValue" Text="{Binding Ipv6Address}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding WifiStandard, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Wi-Fi standard"/><TextBlock Classes="mValue" Text="{Binding WifiStandard}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding SignalPercent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Signal %"/><TextBlock Classes="mValue" Text="{Binding SignalPercent}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding Bssid, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="BSSID"/><TextBlock Classes="mValue" Text="{Binding Bssid}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding DhcpServer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="DHCP server"/><TextBlock Classes="mValue" Text="{Binding DhcpServer}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding Gateway, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Gateway"/><TextBlock Classes="mValue" Text="{Binding Gateway}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding Dns1, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="DNS 1"/><TextBlock Classes="mValue" Text="{Binding Dns1}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding Dns2, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="DNS 2"/><TextBlock Classes="mValue" Text="{Binding Dns2}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding Netmask, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Netmask"/><TextBlock Classes="mValue" Text="{Binding Netmask}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding NonMobileTraffic, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Non-mobile traffic"/><TextBlock Classes="mValue" Text="{Binding NonMobileTraffic}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding MobileTraffic, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Mobile traffic"/><TextBlock Classes="mValue" Text="{Binding MobileTraffic}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding DownloadedSinceBoot, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Downloaded since boot"/><TextBlock Classes="mValue" Text="{Binding DownloadedSinceBoot}"/></DockPanel>
                                    <DockPanel Classes="mRow" IsVisible="{Binding UploadedSinceBoot, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Uploaded since boot"/><TextBlock Classes="mValue" Text="{Binding UploadedSinceBoot}"/></DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:GpuViewModel}" x:DataType="vm:GpuViewModel">
                    <ScrollViewer>
                        <StackPanel Margin="16" Spacing="12">
                            <TextBlock Classes="mTitle" Text="GPU"/>
                            <TextBlock Classes="mSub" Text="{Binding GpuName}"/>

                            <Border Classes="mCard">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="mLabel" Margin="0" Text="Integrated" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Classes="mSub" Text="{Binding Integrated.GpuName}" IsVisible="{Binding Integrated.HasGpu}"/>
                                    <TextBlock Classes="mSub" Text="{Binding Integrated.EmptyLabel}" IsVisible="{Binding !Integrated.HasGpu}"/>
                                    <StackPanel Spacing="6" IsVisible="{Binding Integrated.HasGpu}">
                                        <StackPanel Spacing="6" IsVisible="{Binding Integrated.Utilization, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Classes="mLabel" Margin="0" Text="Utilization"/>
                                            <TextBlock Classes="mBig" Text="{Binding Integrated.Utilization}"/>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Integrated.UtilizationValue}"/>
                                        </StackPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Integrated.Temperature, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Temperature"/><TextBlock Classes="mValue" Text="{Binding Integrated.Temperature}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Integrated.MemoryUsage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="GPU memory"/><TextBlock Classes="mValue" Text="{Binding Integrated.MemoryUsage}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Integrated.SharedMemoryUsage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Shared memory"/><TextBlock Classes="mValue" Text="{Binding Integrated.SharedMemoryUsage}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Integrated.DriverVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Driver version"/><TextBlock Classes="mValue" Text="{Binding Integrated.DriverVersion}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Integrated.DriverDate, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Driver date"/><TextBlock Classes="mValue" Text="{Binding Integrated.DriverDate}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Integrated.GraphicsApi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Graphics API"/><TextBlock Classes="mValue" Text="{Binding Integrated.GraphicsApi}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Integrated.PhysicalLocation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Location"/><TextBlock Classes="mValue" Text="{Binding Integrated.PhysicalLocation}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Integrated.Vendor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Vendor"/><TextBlock Classes="mValue" Text="{Binding Integrated.Vendor}"/></DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="mCard" IsVisible="{Binding Dedicated.HasGpu}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="mLabel" Margin="0" Text="Dedicated" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Classes="mSub" Text="{Binding Dedicated.GpuName}"/>
                                    <StackPanel Spacing="6">
                                        <StackPanel Spacing="6" IsVisible="{Binding Dedicated.Utilization, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Classes="mLabel" Margin="0" Text="Utilization"/>
                                            <TextBlock Classes="mBig" Text="{Binding Dedicated.Utilization}"/>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Dedicated.UtilizationValue}"/>
                                        </StackPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Dedicated.Temperature, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Temperature"/><TextBlock Classes="mValue" Text="{Binding Dedicated.Temperature}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Dedicated.MemoryUsage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="GPU memory"/><TextBlock Classes="mValue" Text="{Binding Dedicated.MemoryUsage}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Dedicated.SharedMemoryUsage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Shared memory"/><TextBlock Classes="mValue" Text="{Binding Dedicated.SharedMemoryUsage}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Dedicated.DriverVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Driver version"/><TextBlock Classes="mValue" Text="{Binding Dedicated.DriverVersion}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Dedicated.DriverDate, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Driver date"/><TextBlock Classes="mValue" Text="{Binding Dedicated.DriverDate}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Dedicated.GraphicsApi, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Graphics API"/><TextBlock Classes="mValue" Text="{Binding Dedicated.GraphicsApi}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Dedicated.PhysicalLocation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Location"/><TextBlock Classes="mValue" Text="{Binding Dedicated.PhysicalLocation}"/></DockPanel>
                                        <DockPanel Classes="mRow" IsVisible="{Binding Dedicated.Vendor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="mLabel" Text="Vendor"/><TextBlock Classes="mValue" Text="{Binding Dedicated.Vendor}"/></DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>

            </ContentControl.DataTemplates>
        </ContentControl>

        <Border x:Name="MobileNavBorder" Grid.Row="1" Background="#252526">
            <UniformGrid Rows="1">
                <Button Classes="mNav" Command="{Binding SelectHomeCommand}" Tag="{Binding IsHomeActive}">
                    <StackPanel><TextBlock Classes="mNavIcon" Text="🏠"/><TextBlock Classes="mNavText" Text="Home"/></StackPanel>
                </Button>
                <Button Classes="mNav" Command="{Binding SelectCpuCommand}" Tag="{Binding IsCpuActive}">
                    <StackPanel><TextBlock Classes="mNavIcon" Text="⚙"/><TextBlock Classes="mNavText" Text="CPU"/></StackPanel>
                </Button>
                <Button Classes="mNav" Command="{Binding SelectMemoryCommand}" Tag="{Binding IsMemoryActive}">
                    <StackPanel><TextBlock Classes="mNavIcon" Text="🧩"/><TextBlock Classes="mNavText" Text="Memory"/></StackPanel>
                </Button>
                <Button Classes="mNav" Command="{Binding SelectDiskCommand}" Tag="{Binding IsDiskActive}">
                    <StackPanel><TextBlock Classes="mNavIcon" Text="💾"/><TextBlock Classes="mNavText" Text="Storage"/></StackPanel>
                </Button>
                <Button Classes="mNav" Command="{Binding SelectWifiCommand}" Tag="{Binding IsWifiActive}">
                    <StackPanel><TextBlock Classes="mNavIcon" Text="📶"/><TextBlock Classes="mNavText" Text="Wi-Fi"/></StackPanel>
                </Button>
                <Button Classes="mNav" Command="{Binding SelectGpuCommand}" Tag="{Binding IsGpuActive}">
                    <StackPanel><TextBlock Classes="mNavIcon" Text="🎮"/><TextBlock Classes="mNavText" Text="GPU"/></StackPanel>
                </Button>
            </UniformGrid>
        </Border>
    </Grid>

    </Panel>
</UserControl>
